# FretCoach settings. Copy this file to .env and fill in what you use, then restart ./start.sh.
# .env is ignored by git, so your keys never get committed.

# ---- Free: Ollama, AI that runs on your own computer (https://ollama.com) ----
# Web search for Ollama, so it reads real chord sheets instead of guessing from memory.
# Free: make an ollama.com account, then create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Optional: the model to pick first (you can also choose it on the Add song page).
# OLLAMA_MODEL=qwen3:4b-instruct
# Optional: where Ollama runs, if not on this computer's default port.
# OLLAMA_HOST=http://127.0.0.1:11434

# ---- Most accurate, paid: Claude ----
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: which AI the Add song page picks first when both are set up: ollama or claude.
# AI_PROVIDER=ollama
